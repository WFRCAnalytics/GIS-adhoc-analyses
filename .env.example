# ArcGIS credentials for accessing private/secured feature services.
# Copy this file to .env and fill in your values. Never commit .env.

ARCGIS_PORTAL_URL=https://your-portal.com
ARCGIS_USERNAME=your_username
ARCGIS_PASSWORD=your_password

MOBILITY_DATABASE_REFRESH_TOKEN=token_placeholder

# Mobility Database (GTFS archive) -- used by gis_adhoc_analyses.mobility_database
# Get a refresh token at https://mobilitydatabase.org (Account details).
MOBILITY_DATABASE_REFRESH_TOKEN=your_refresh_token
