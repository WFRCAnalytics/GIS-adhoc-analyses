# ArcGIS credentials for accessing private/secured feature services.
# Copy this file to .env and fill in your values. Never commit .env.

ARCGIS_USERNAME=your_username
ARCGIS_PASSWORD=your_password

# Optional: defaults to ArcGIS Online if not set.
# Set this if your data is on an on-premise Portal.
# ARCGIS_PORTAL_URL=https://your-portal.com
